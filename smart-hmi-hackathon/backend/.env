# ARIA Backend — Environment Variables
# Copy this file as .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
# Option 1: SQLite (default — works out of the box, no install needed)
DATABASE_URL=sqlite:///./aria.db

# Option 2: MySQL — uncomment and fill in credentials if using MySQL
# DATABASE_URL=mysql+pymysql://username:password@localhost/aria_db

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin (for production, replace * with your frontend URL)
FRONTEND_URL=http://localhost:3000
